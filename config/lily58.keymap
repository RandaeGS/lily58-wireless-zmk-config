#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <175>;    // The time to distinguish between a tap and a hold
            quick-tap-ms = <125>;       // Enable quick tap
            global-quick-tap;           // Enable global quick tap
            flavor = "tap-preferred";    // Prefer tap when both tap and hold are possible
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&none  &none           &none           &none             &none               &none                              &none            &none                &none              &none           &none            &none
&none  &kp Q           &kp W           &kp F             &kp P               &kp B                              &kp J            &kp L                &kp U              &kp Y           &kp SEMICOLON    &none
&none  &hm LEFT_GUI A  &hm LEFT_ALT R  &hm LEFT_SHIFT S  &hm LEFT_CONTROL T  &kp G                              &kp M            &hm RIGHT_CONTROL N  &hm RIGHT_SHIFT E  &hm LEFT_ALT I  &hm RIGHT_GUI O  &none
&none  &kp Z           &kp X           &kp C             &kp D               &kp V      &tog 2       &tog 0     &kp K            &kp H                &kp COMMA          &kp DOT         &kp ESC          &none
                                       &none             &lt 1 ESC           &lt 2 TAB  &kp SPACE    &kp ENTER  &lt 1 BACKSPACE  &lt 3 DELETE         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol_layer {
            // Rest of the layers remain the same...

            display-name = "Lower";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4                    &trans            &trans             &trans                &trans                 &trans         &trans
&trans      &kp HASH      &kp UNDERSCORE  &kp AMPERSAND  &kp PIPE      &kp PERCENT                     &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH  &trans
&trans      &kp EXCL      &kp MINUS       &kp PLUS       &kp EQUAL     &kp COLON                       &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION   &trans
&trans      &kp TILDE     &kp ASTERISK    &kp DOLLAR     &kp AT_SIGN   &kp CARET     &trans    &trans  &kp GRAVE         &kp PERIOD         &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SLASH      &trans
                                          &trans         &trans        &trans        &trans    &trans  &trans            &trans             &trans
            >;
        };

        nav_layer {
            display-name = "Raise";
            bindings = <
&trans  &trans        &trans  &trans  &trans  &trans                    &trans         &trans       &trans      &trans     &trans      &trans
&trans  &trans        &kp N7  &kp N8  &kp N9  &trans                    &kp K_REDO     &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO  &trans
&trans  &kp NUMBER_0  &kp N4  &kp N5  &kp N6  &trans                    &kp CAPSLOCK   &kp LEFT     &kp DOWN    &kp UP     &kp RIGHT   &trans
&trans  &trans        &kp N1  &kp N2  &kp N3  &trans  &trans    &trans  &kp INSERT     &kp HOME     &kp PG_DN   &kp PG_UP  &kp END     &trans
                              &trans  &trans  &trans  &trans    &trans  &kp BACKSPACE  &kp DELETE   &trans
            >;
        };

        FUNCTION_LAYER {
            bindings = <
&trans  &trans      &trans            &trans      &trans   &trans                    &trans  &trans   &trans  &trans  &trans   &trans
&trans  &trans      &trans            &trans      &trans   &trans                    &trans  &trans   &trans  &trans  &trans   &trans
&trans  &kp F1      &kp F2            &kp F3      &kp F4   &kp F5                    &kp F6  &kp F7   &kp F8  &kp F9  &kp F10  &trans
&trans  &kp K_PREV  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp F11  &trans  &trans    &trans  &trans  &kp F12  &trans  &trans  &trans   &trans
                                      &trans      &trans   &trans  &trans    &trans  &trans  &trans   &trans
            >;
        };
    };
};
