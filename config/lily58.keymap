#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;    // The time to distinguish between a tap and a hold
            quick-tap-ms = <125>;       // Enable quick tap
            global-quick-tap;           // Enable global quick tap
            flavor = "tap-preferred";    // Prefer tap when both tap and hold are possible
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC           &kp N1          &kp N2          &kp N3            &kp N4              &kp N5                          &kp N6  &kp N7               &kp N8             &kp N9          &kp N0           &kp BSLH
&kp TAB           &kp Q           &kp W           &kp F             &kp P               &kp B                           &kp J   &kp L                &kp U              &kp Y           &kp SEMICOLON    &kp DELETE
&sk LSHFT         &hm LEFT_GUI A  &hm LEFT_ALT R  &hm LEFT_SHIFT S  &hm LEFT_CONTROL T  &kp G                           &kp M   &hm RIGHT_CONTROL N  &hm RIGHT_SHIFT E  &hm LEFT_ALT I  &hm RIGHT_GUI O  &sk RIGHT_SHIFT
&kp LEFT_CONTROL  &kp Z           &kp X           &kp C             &kp D               &kp V   &tog 2       &tog 0     &kp K   &kp H                &kp COMMA          &kp DOT         &kp FSLH         &kp RIGHT_CONTROL
                                                  &kp LALT          &kp LEFT_GUI        &mo 1   &kp SPACE    &kp ENTER  &mo 2   &kp BACKSPACE        &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol_layer {
            // Rest of the layers remain the same...

            display-name = "Lower";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4                    &trans            &trans             &trans                &trans                 &trans         &trans
&trans      &kp HASH      &kp UNDERSCORE  &kp AMPERSAND  &kp PIPE      &kp PERCENT                     &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH  &trans
&trans      &kp EXCL      &kp MINUS       &kp PLUS       &kp EQUAL     &kp COLON                       &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION   &trans
&trans      &kp TILDE     &kp ASTERISK    &kp DOLLAR     &kp AT_SIGN   &kp CARET     &trans    &trans  &kp COMMA         &kp PERIOD         &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SLASH      &trans
                                          &trans         &trans        &trans        &trans    &trans  &trans            &trans             &trans
            >;
        };

        nav_layer {
            display-name = "Raise";
            bindings = <
&trans  &trans      &trans            &kp K_PLAY_PAUSE  &trans     &kp PRINTSCREEN                    &trans        &trans  &none   &kp PERCENT  &kp FSLH   &trans
&trans  &none       &kp PG_DN         &kp PG_UP         &none      &trans                             &trans        &kp N7  &kp N8  &kp N9       &kp STAR   &trans
&trans  &kp LEFT    &kp DOWN_ARROW    &kp UP            &kp RIGHT  &kp END                            &kp NUMBER_0  &kp N4  &kp N5  &kp N6       &kp MINUS  &trans
&trans  &kp K_PREV  &kp K_PLAY_PAUSE  &kp K_NEXT        &kp HOME   &trans           &trans    &trans  &kp NUMBER_0  &kp N1  &kp N2  &kp N3       &kp PLUS   &trans
                                      &trans            &trans     &trans           &trans    &trans  &trans        &trans  &trans
            >;
        };

        FUNCTION_LAYER {
            bindings = <
&trans  &trans  &trans  &trans  &trans   &trans                    &trans  &trans   &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans   &trans                    &trans  &trans   &trans  &trans  &trans   &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5                    &kp F6  &kp F7   &kp F8  &kp F9  &kp F10  &trans
&trans  &trans  &trans  &trans  &kp F11  &trans  &trans    &trans  &trans  &kp F12  &trans  &trans  &trans   &trans
                        &trans  &trans   &trans  &trans    &trans  &trans  &trans   &trans
            >;
        };
    };
};
